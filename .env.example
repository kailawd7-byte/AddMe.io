# Base de données (PostgreSQL Neon / Supabase / Prisma Postgres)
DATABASE_URL="postgresql://user:pass@ep-host.region.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-host.region.supabase.com:5432/postgres?sslmode=require"

# Sécurité & Sessions
JWT_SECRET="remplacer_par_une_cle_secrete_aleatoire_de_64_caracteres"
NEXT_PUBLIC_APP_URL="https://votredomaine.vercel.app"

# Configuration des Emails Transactionnels (Mot de passe oublié, Activation compte)
# Option A : API Resend (Hautement recommandé pour Vercel - Gratuit 3 000 emails/mois sur https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="AddMe.io <support@addme.io>"

# Option B : Serveur SMTP Universel (Gmail, Hostinger, OVH, Zoho, etc.)
# Ex Gmail : SMTP_HOST="smtp.gmail.com" / SMTP_PORT=465 / SMTP_SECURE=true / SMTP_USER="monemail@gmail.com" / SMTP_PASS="mot_de_passe_application_16_lettres"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# Stripe (Boutique de points)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Tâches planifiées (Jobs en arrière-plan)
CRON_SECRET="secret_token_pour_proteger_les_endpoints_cron"

# ============================================================================
# 🤖 ADDME AI SENTINEL — TRACKING D'ENGAGEMENT & IA VISION ANTI-FRAUDE
# ============================================================================
ADDME_AI_SENTINEL_MODE="autonomous_and_vision"

# 1. Agent IA Vision Multimodal (Vérification visuelle des preuves d'abonnement/like/commentaire)
